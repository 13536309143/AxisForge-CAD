test("ground mate persists through size orientation and serialization", [] {
    Scene s;
    auto body = makeBody(Shape::Box);
    body.position = {20, 30, -80};
    s.bodies << body;
    Mate m;
    m.id = "floor-mate";
    m.source = "@ground";
    m.target = body.id;
    m.type = MateType::Ground;
    m.offset = 0;
    s.mates << m;
    CHECK(solve(s));
    CHECK(std::abs(minimumWorldZ(s.bodies[0])) < .001);
    CHECK(s.bodies[0].position.x() == 20);
    s.bodies[0].params.height = 70;
    s.bodies[0].rotation = QQuaternion::fromEulerAngles(20, 30, 40);
    CHECK(solve(s));
    CHECK(residual(s, m).satisfied());
    Scene loaded;
    CHECK(deserialize(serialize(s), loaded));
    CHECK(loaded.mates[0].type == MateType::Ground);
    CHECK(QJsonDocument::fromJson(serialize(s)).object()["version"].toInt() == 6);
    CHECK(mateGuide(s, m).valid);
    CHECK(!mateGuide(s, m).lines.isEmpty());
});
test("ground clearance disabled state and fixed conflict are explicit", [] {
    Scene s;
    s.bodies << makeBody(Shape::Sphere);
    Mate m;
    m.id = "floor";
    m.source = "@ground";
    m.target = s.bodies[0].id;
    m.type = MateType::Ground;
    m.offset = 12;
    s.mates << m;
    CHECK(solve(s));
    CHECK(std::abs(minimumWorldZ(s.bodies[0]) - 12) < .001);
    s.mates[0].enabled = false;
    s.bodies[0].position.setZ(-80);
    CHECK(solve(s));
    CHECK(s.bodies[0].position.z() == -80);
    s.mates[0].enabled = true;
    s.bodies[0].fixed = true;
    auto before = serialize(s);
    CHECK(!solve(s));
    CHECK(serialize(s) == before);
});
